{{ 'strive-base.css' | asset_url | stylesheet_tag }}
{{ 'strive-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign combos = section.settings.combos
-%}

<div class="sv-scope">
<section class="sv-sec" id="{{ section.id }}">
  <div class="sv-wrap">
    <div class="sv-panel-head sv-rv">
      <span class="sv-kicker">{{ section.settings.kicker }}</span>
      <h2 class="sv-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="sv-rule" style="margin-left:auto;margin-right:auto"><i></i>{% render 'strive-icon', name: 'leaf' %}<i></i></div>
      <p class="sv-lede" style="margin:14px auto 0">{{ section.settings.subtext }}</p>
    </div>

    {%- if combos.size > 0 -%}
      <div class="sv-comborail sv-rv">
        {%- for combo in combos -%}
          {%- liquid
            assign products = combo.products.value
            assign captions = combo.captions.value
            assign sum_price = 0
            assign sum_compare = 0
            for p in products
              assign c = p.compare_at_price
              if c == blank or c <= 0
                assign c = p.price
              endif
              assign sum_compare = sum_compare | plus: c
              assign sum_price = sum_price | plus: p.price
            endfor
            assign bundle_price = sum_price
            if combo.flat_price.value > 0
              assign bundle_price = combo.flat_price.value | times: 100
            endif
            assign savings = sum_compare | minus: bundle_price
          -%}
          <article class="sv-glass sv-combo{% if combo.featured.value %} sv-hero-combo{% endif %}">
            <div class="sv-tray">
              {%- if savings > 0 -%}<span class="sv-save">You save {{ savings | money_without_trailing_zeros }}</span>{%- endif -%}
              {%- if combo.badge.value != blank -%}<span class="sv-flag">{{ combo.badge.value }}</span>{%- endif -%}
              <div class="sv-stack">
                {%- for p in products limit: 3 -%}
                  <span class="sv-it">
                    {%- if p.featured_image -%}
                      <span class="sv-pimg" style="background-image:url('{{ p.featured_image | image_url: width: 200 }}')" role="img" aria-label="{{ p.title }}"></span>
                    {%- endif -%}
                    <span>{{ captions[forloop.index0] }}</span>
                  </span>
                  {%- unless forloop.last -%}<span class="sv-plus" aria-hidden="true">+</span>{%- endunless -%}
                {%- endfor -%}
              </div>
            </div>
            <div class="sv-body">
              <h3>{{ combo.title.value }}</h3>
              <div class="sv-cnt">{{ products.size }} products</div>
              <p class="sv-inc">{{ combo.description.value }}</p>
              <div class="sv-prow">
                <strong>{{ bundle_price | money_without_trailing_zeros }}</strong>
                {%- if sum_compare > bundle_price -%}<s>{{ sum_compare | money_without_trailing_zeros }}</s><em>Save {{ savings | money_without_trailing_zeros }}</em>{%- endif -%}
              </div>
              <div class="sv-fine">Inclusive of all taxes &middot; COD available</div>
              <a class="sv-btn {% if combo.featured.value %}sv-btn-primary{% else %}sv-btn-ghost{% endif %}" href="{{ combo.cta_link.value | default: '#bundles' }}">
                Shop bundle {% render 'strive-icon', name: 'arrow' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <div class="sv-swipecue" aria-hidden="true">{% render 'strive-icon', name: 'arrow' %}Swipe for more combos</div>
      <p class="sv-railnote">{{ section.settings.footnote }}</p>
    {%- else -%}
      <p class="sv-body-s" style="text-align:center">Add combos from Content &rsaquo; Metaobjects &rsaquo; Combo, then pick them in this section's settings.</p>
    {%- endif -%}
  </div>
</section>
</div>

{{ 'strive-sections.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Strive Combos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling stacks" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Swipe through the stacks people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "footnote", "label": "Rail footnote", "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay." },
    {
      "type": "metaobject_list",
      "id": "combos",
      "label": "Combos",
      "metaobject_type": "combo"
    }
  ],
  "presets": [ { "name": "Strive Combos" } ]
}
{% endschema %}
