{{ 'strive-base.css' | asset_url | stylesheet_tag }}
{{ 'strive-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tiers = section.settings.tiers
-%}

<div class="sv-scope">
<section class="sv-sec" id="{{ section.id }}">
  <div class="sv-wrap">
    <div class="sv-glass sv-sec-pad sv-rv" style="margin-bottom:16px">
      <div class="sv-panel-head" style="margin-bottom:0">
        <span class="sv-kicker">{{ section.settings.kicker }}</span>
        <h2 class="sv-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="sv-lede" style="margin:0 auto">{{ section.settings.subtext }}</p>
      </div>
    </div>

    {%- if tiers.size > 0 -%}
      <div class="sv-tiers" id="bundles-tiers-{{ section.id }}">
        {%- for tier in tiers -%}
          {%- liquid
            assign samples = tier.sample_products.value
            assign price = tier.price.value | times: 100
            assign compare = tier.compare_at.value | times: 100
            assign qty = samples.size
          -%}
          <article class="sv-glass sv-tier sv-rv sv-rv-d{{ forloop.index }}{% if tier.featured.value %} sv-best{% endif %}">
            {%- if tier.tag.value != blank -%}<span class="sv-tag">{{ tier.tag.value }}</span>{%- endif -%}
            {%- if samples.size > 0 -%}
              <div class="sv-tierpix{% if samples.size >= 5 %} sv-five{% endif %}" aria-hidden="true">
                {%- for p in samples limit: 5 -%}
                  {%- if p.featured_image -%}
                    <span class="sv-pimg" style="background-image:url('{{ p.featured_image | image_url: width: 160 }}')" role="img" aria-label="{{ p.title }}"></span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="sv-qty">{{ tier.quantity.value }}<small>Products</small></div>
            <div class="sv-price">{{ price | money_without_trailing_zeros }}
              {%- if compare > price -%}<s>{{ compare | money_without_trailing_zeros }}</s>{%- endif -%}
            </div>
            {%- if tier.quantity.value > 0 -%}
              <p class="sv-body-s" style="font-size:12px">Flat {{ price | divided_by: tier.quantity.value | money_without_trailing_zeros }} per product</p>
            {%- endif -%}
            <ul>
              {%- for feature in tier.features.value -%}
                <li>{% render 'strive-icon', name: 'check' %}{{ feature }}</li>
              {%- endfor -%}
            </ul>
            <a class="sv-btn {% if tier.featured.value %}sv-btn-primary{% else %}sv-btn-ghost{% endif %}" href="{{ tier.cta_link.value | default: '#shop' }}">
              Build this box
              {%- if tier.featured.value %} {% render 'strive-icon', name: 'arrow' %}{% endif -%}
            </a>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="sv-body-s" style="text-align:center">Add tiers from Content &rsaquo; Metaobjects &rsaquo; Bundle tier, then pick them in this section's settings.</p>
    {%- endif -%}

    <p class="sv-body-s" style="text-align:center;margin-top:16px">
      {{ section.settings.disclaimer }}
    </p>
  </div>
</section>
</div>

{{ 'strive-sections.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Strive Bundles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your stack" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every goal." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Mix and match across protein, creatine and snacking. One flat price, no code needed, free shipping either way." },
    { "type": "textarea", "id": "disclaimer", "label": "Fine-print disclaimer", "default": "Flat pricing is applied at checkout once your box is built on the Shop page." },
    {
      "type": "metaobject_list",
      "id": "tiers",
      "label": "Bundle tiers",
      "metaobject_type": "bundle_tier"
    }
  ],
  "presets": [ { "name": "Strive Bundles" } ]
}
{% endschema %}
